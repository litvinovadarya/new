import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

public class MainTest {
    @Test
    public void testFactorialPositive() {
        assertEquals(120, Main.factorial(5)); // 5! = 120
    }
    @Test
    public void testFactorialZero() {
        assertEquals(1, Main.factorial(0)); // 0! = 1
    }
    @Test
    public void testFactorialNegative() {
        assertThrows(IllegalArgumentException.class, () -> Main.factorial(-1)); // Отрицательное число
    }
    @Test
    public void testCalculateArea() {
        assertEquals(10.0, Main.calculateArea(4, 5)); // Площадь = 0.5 * 4 * 5 = 10.0
    }
    @Test
    public void testCalculateAreaInvalidInput() {
        assertThrows(IllegalArgumentException.class, () -> Main.calculateArea(-1, 5)); // Отрицательные значения
    }
    @Test
    public void testAdd() {
        assertEquals(7, Main.add(3, 4)); // 3 + 4 = 7
    }
    @Test
    public void testSubtract() {
        assertEquals(1, Main.subtract(5, 4)); // 5 - 4 = 1
    }
    @Test
    public void testMultiply() {
        assertEquals(12, Main.multiply(3, 4)); // 3 * 4 = 12
    }

    @Test
    public void testDivide() {
        assertEquals(2.5, Main.divide(5, 2)); // 5 / 2 = 2.5
    }
    @Test
    public void testDivideByZero() {
        assertThrows(ArithmeticException.class, () -> Main.divide(5, 0)); // Деление на ноль
    }
    @Test
    public void testCompareGreater() {
        assertEquals("greater", Main.compare(5, 3)); // 5 > 3
    }
    @Test
    public void testCompareLesser() {
        assertEquals("lesser", Main.compare(3, 5)); // 3 < 5
    }
    @Test
    public void testCompareEqual() {
        assertEquals("equal", Main.compare(4, 4)); // 4 == 4
    }
}
