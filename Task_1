class Animal {
    protected String name;
    protected static int count = 0; 
    public Animal(String name) {
        this.name = name;
        count++;
    }
    public void run(int distance) {
        System.out.println(name + " пробежал " + distance + " м");
    }
    public void swim(int distance) {
        System.out.println(name + " проплыл " + distance + " м");
    }
    public static int getCount() {
        return count;
    }
}
class Dog extends Animal {
    private static final int MAX_RUN_DISTANCE = 500;
    private static final int MAX_SWIM_DISTANCE = 10;
    public Dog(String name) {
        super(name);
    }
   @Override
    public void run(int distance) {
        if (distance <= MAX_RUN_DISTANCE) {
            System.out.println(name + " быстро пробежал " + distance + " м");
        } else {
            System.out.println(name + " не может пробежать больше " + MAX_RUN_DISTANCE + " м");
        }
    }
    @Override
    public void swim(int distance) {
        if (distance <= MAX_SWIM_DISTANCE) {
            System.out.println(name + " с радостью проплыл " + distance + " м");
        } else {
            System.out.println(name + " не может проплыть больше " + MAX_SWIM_DISTANCE + " м");
        }
    }
}
class Cat extends Animal {
    private static final int MAX_RUN_DISTANCE = 200;
    private boolean isFull;
    public Cat(String name) {
        super(name);
        this.isFull = false; 
    }
    @Override
    public void run(int distance) {
        if (distance <= MAX_RUN_DISTANCE) {
            System.out.println(name + " скромно пробежал " + distance + " м");
        } else {
            System.out.println(name + " не может пробежать больше " + MAX_RUN_DISTANCE + " м");
        }
    }
    @Override
    public void swim(int distance) {
           System.out.println(name + " не умеет плавать.");
    }
    public boolean eat(Bowl bowl) {
        if (bowl.getFoodAmount() > 0) {
            bowl.takeFood();
            this.isFull = true; // Кот стал сытым
            System.out.println(name + " покушал и теперь сыт");
            return true;
        } else {
            System.out.println(name + " не нашел еды в миске");
            return false;
        }
    }
    public boolean isFull() {
        return isFull;
    }
}

class Bowl {
    private int foodAmount;
    public Bowl(int foodAmount) {
        this.foodAmount = foodAmount;
    }
    public void addFood(int amount) {
        if (amount > 0) {
            foodAmount += amount; // Добавление еды в миску
            System.out.println("В миску добавлено " + amount + " еды. Теперь в миске " + foodAmount + " еды.");
        }
    }
    public int getFoodAmount() {
        return foodAmount;
    }
    public void takeFood() {
        if (foodAmount > 0) {
            foodAmount--;
        }
    }
}
public class Main {
    public static void main(String[] args) {
        Dog dogBobik = new Dog("Бобик");
        Cat catMurzik = new Cat("Мурзик");
        dogBobik.run(150);
        dogBobik.swim(5);
        catMurzik.run(100);
        catMurzik.swim(30); 
        Bowl bowl = new Bowl(3);
        Cat[] cats = {
                new Cat("Василий"),
                new Cat("Беляш"),
                new Cat("Котя"),
        };
        for (Cat cat : cats) {
            cat.eat(bowl);
        }
        System.out.println("Состояние сытости котов:");
        for (Cat cat : cats) {
            System.out.println(cat.name + " сыт: " + cat.isFull());
        }
        bowl.addFood(5);
        for (Cat cat : cats) {
            cat.eat(bowl);
        }
    }
}
