public class Main {
    public static void main(String[] args) {
        System.out.println("Факториал 5: " + Factorial.computeFactorial(5));
        System.out.println("Площадь треугольника с основанием 10 и высотой 5: " +
                TriangleArea.computeArea(10, 5));
        int a = 10, b = 5;
        System.out.println("Сложение: " + ArithmeticOperations.add(a, b));
        System.out.println("Вычитание: " + ArithmeticOperations.subtract(a, b));
        System.out.println("Умножение: " + ArithmeticOperations.multiply(a, b));
        System.out.println("Деление: " + ArithmeticOperations.divide(a, b));
        System.out.println(CompareNumbers.compare(a, b));
    }
}

class Factorial {
    public static long computeFactorial(int number) {
        if (number < 0) throw new IllegalArgumentException("Number must be non-negative.");
        long result = 1;
        for (int i = 1; i <= number; i++) {
            result *= i;
        }
        return result;
    }
}
class TriangleArea {
    public static double computeArea(double base, double height) {
        if (base < 0 || height < 0) throw new IllegalArgumentException("Base and height must be non-negative.");
        return (base * height) / 2;
    }
}
class ArithmeticOperations {
    public static int add(int a, int b) {
        return a + b;
    }
    public static int subtract(int a, int b) {
        return a - b;
    }
    public static int multiply(int a, int b) {
        return a * b;
    }
    public static double divide(int a, int b) {
        if (b == 0) throw new ArithmeticException("Division by zero.");
        return (double) a / b;
    }
}
class CompareNumbers {
    public static String compare(int a, int b) {
        if (a > b) return a + " больше " + b;
        else if (a < b) return a + " меньше " + b;
        else return a + " равно " + b;
    }
}

